# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection: postgresql+psycopg2://USER@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://your_mac_username@localhost:5433/flight_delays

# AeroDataBox flight API key from RapidAPI (free Basic plan)
RAPIDAPI_KEY=

# Google Gemini API key (news tagging and the chat assistant)
GEMINI_API_KEY=
